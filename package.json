{
  "name": "rpg-origins",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "image:generate": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node tools/images/cli.ts generate",
    "image:edit": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node tools/images/cli.ts edit",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "image:review": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node tools/images/cli.ts review",
    "image:status": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node tools/images/cli.ts status",
    "test:images": "NODE_NO_WARNINGS=1 node --test \"tools/images/tests/*.test.ts\"",
    "image:inventory": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node tools/images/cli.ts inventory",
    "image:inspect": "NODE_USE_ENV_PROXY=1 NODE_NO_WARNINGS=1 node tools/images/cli.ts inspect",
    "test": "npm run test:images && npm run validate",
    "validate": "rolldown -c rolldown.validate.mjs >/dev/null 2>&1; node dist-tools/validate.mjs",
    "validate:needs": "rolldown -c rolldown.validate.mjs >/dev/null 2>&1; node dist-tools/validate.mjs --needs",
    "coverage": "rolldown -c rolldown.validate.mjs >/dev/null 2>&1; node dist-tools/validate.mjs --coverage"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
